  "sections": {
    "en": {
      "business_permit": {
        "service_id": "business_permit",
        "service_name": "Business Permit",
        "office": "Business Permits & Licensing Office",
        "info_status": "confirmed",
        "summary": {
          "requirement_count": 14,
          "fee_text": "₱235.50",
          "time_text": "37 minutes"
        },
        "checklist": [
          "Duly accomplished Mayor’s Permit Application Form",
          "Brgy. Business Clearance & Solid Waste Certification",
          "City Solid Waste Certification",
          "Single Proprietor – Owner’s Cedula; Corporation – Corporation Cedula",
          "Single Proprietor: DTI Certification of Registration",
          "Corporation: SEC Certificate of Incorporation",
          "Corporation: By-Laws (for new business)",
          "Corporation: Articles of Incorporation (for new business)",
          "Association: SEC Certificate of Registration",
          "Corporation: CDA Certificate of Registration",
          "Fire Safety Inspection Certification",
          "Sanitary Permit to Operate",
          "Employee’s Occupational Permit (proof of payment only)",
          "Locational Clearance (subject to assessment of location)"
        ],
        "fees": [
          {
            "label": "Zoning",
            "amount_text": "₱30.00"
          },
          {
            "label": "Sanitary Services",
            "amount_text": "₱100.00"
          },
          {
            "label": "Business Name Clearance",
            "amount_text": "₱5.50"
          },
          {
            "label": "Signboard",
            "amount_text": "₱100.00"
          }
        ],
        "steps": [
          {
            "order": 1,
            "text": "Approach receiving employee",
            "time_text": "2 minutes",
            "external": false
          },
          {
            "order": 2,
            "text": "Submit complete requirements with citizen’s signature & filled-out Mayor’s Permit application form",
            "time_text": "2 minutes",
            "external": false
          },
          {
            "order": 3,
            "text": "Wait for the TOP",
            "time_text": "5 minutes",
            "external": false
          },
          {
            "order": 4,
            "text": "Signs TOP / Release Book",
            "time_text": "5-10 minutes",
            "external": false
          },
          {
            "order": 5,
            "text": "Proceed to the City Treasurer’s Office for payment",
            "time_text": null,
            "external": true
          },
          {
            "order": 6,
            "text": "Proceed to the BPLO main office with the proof of payment (official receipt) and complete set of documents",
            "time_text": "5 minutes",
            "external": false
          },
          {
            "order": 7,
            "text": "Prepare & print Business/Mayor’s Permit",
            "time_text": "5 minutes",
            "external": false
          },
          {
            "order": 8,
            "text": "Approval of Business/Mayor’s Permit",
            "time_text": "3-5 minutes",
            "external": false
          },
          {
            "order": 9,
            "text": "Record and release approved Business/Mayor’s",
            "time_text": "2-3 minutes",
            "external": false
          },
          {
            "order": 10,
            "text": "Receive permit & sign on the release record book",
            "time_text": null,
            "external": false
          }
        ],
        "notes": [
          "Some items are only for some kinds of business. Bring the ones for yours."
        ],
        "related": [
          {
            "label": "Sanitary Permit to Operate",
            "office": "City Health Office",
            "note": "Get this first, then come back."
          }
        ]
      },
