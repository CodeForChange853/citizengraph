    "muted": "text",
    "edge": "edge",
    "line": "line",
    "accent": "accent",
    "onAccent": "stage",
    "glow": "accent",
    "hot": "accent",
    "alert": "alert",
    "onAlert": "text"
  },
  "decorative": ["line"],
  "rules": {
