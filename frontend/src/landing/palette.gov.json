    "panel": "#081230",
    "text": "#FFFFFF",
    "accent": "#FCD116",
    "line": "#0038A8",
    "edge": "#8DAAEB",
    "alert": "#CE1126"
  },
  "roles": {
    "stage": "stage",
    "panel": "panel",
    "text": "text",
