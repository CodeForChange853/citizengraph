{
  "fees/cheapest/plain": {
    "cypher": [
      "MATCH (o:Office {id: $oid})-[:OFFERS]->(s:Service)-[:HAS_FEE]->(f:Fee)",
      "RETURN s.id, s.name, min(f.amount_min) AS lowest",
      "ORDER BY lowest, s.id",
      "LIMIT 5"
    ],
    "intents": [
      "fees"
    ],
    "params": [
      "oid"
    ]
  },
  "fees/compare_fees/plain": {
    "cypher": [
      "MATCH (s:Service)",
      "WHERE s.id IN [$sid, $sid2]",
      "OPTIONAL MATCH (s)-[:HAS_FEE]->(f:Fee)",
      "RETURN s.id, s.name, s.total_fee_text, count(f) AS n_fees, min(f.amount_min) AS lowest, max(f.amount_max) AS highest",
      "ORDER BY s.id",
      "LIMIT 2"
    ],
    "intents": [
      "fees"
    ],
    "params": [
      "sid",
      "sid2"
    ]
  },
  "fees/fee_time/filtered": {
    "cypher": [
      "MATCH (s:Service {id: $sid})-[:HAS_STEP]->(st:Step)",
      "OPTIONAL MATCH (st)-[:CHARGES]->(f:Fee)",
      "WHERE NOT EXISTS {",
      "MATCH (f)-[:APPLIES_WHEN]->(v:Variant)",
      "WHERE EXISTS { MATCH (x:Variant) WHERE x.id IN $variant_ids AND x.dimension = v.dimension }",
      "AND NOT EXISTS { MATCH (f)-[:APPLIES_WHEN]->(w:Variant) WHERE w.id IN $variant_ids AND w.dimension = v.dimension }",
      "}",
      "RETURN s.total_time_text, st.id, st.order, st.dur_min, st.dur_max, st.dur_unit, st.day_type, st.external_agency, f.id, f.label, f.amount_min, f.amount_max, f.unit, f.note, f.condition_text",
      "ORDER BY st.order, f.id",
      "LIMIT 50"
    ],
    "intents": [
      "fees",
      "processing_time"
    ],
    "params": [
      "sid",
      "variant_ids"
    ]
  },
