  "fees/fees_total/filtered": {
    "cypher": [
      "MATCH (s:Service {id: $sid})-[:HAS_FEE]->(f:Fee)",
      "WHERE NOT EXISTS {",
      "MATCH (f)-[:APPLIES_WHEN]->(v:Variant)",
      "WHERE EXISTS { MATCH (x:Variant) WHERE x.id IN $variant_ids AND x.dimension = v.dimension }",
      "AND NOT EXISTS { MATCH (f)-[:APPLIES_WHEN]->(w:Variant) WHERE w.id IN $variant_ids AND w.dimension = v.dimension }",
      "}",
      "RETURN s.total_fee_text, sum(f.amount_min) AS total_min, sum(f.amount_max) AS total_max, count(f) AS n_fees, count(CASE WHEN f.condition_text IS NOT NULL AND NOT EXISTS { MATCH (f)-[:APPLIES_WHEN]->(:Variant) } THEN 1 END) AS n_unresolved",
      "LIMIT 1"
    ],
    "intents": [
      "fees"
    ],
    "params": [
      "sid",
      "variant_ids"
    ]
  },
